<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.matrix.android105_android.presentation.ui.Home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >

    </fragment>
    <fragment
        android:id="@+id/shopFragment"
        android:name="com.matrix.android105_android.presentation.ui.Shop.ShopFragment"
        android:label="fragment_shop"
        tools:layout="@layout/fragment_shop" >


    </fragment>
    <fragment
        android:id="@+id/bonusFragment"
        android:name="com.matrix.android105_android.presentation.ui.bonus.BonusFragment"
        android:label="fragment_bonus"
        tools:layout="@layout/fragment_bonus" />
    <fragment
        android:id="@+id/servicesFragment"
        android:name="com.matrix.android105_android.presentation.ui.Services.ServicesFragment"
        android:label="fragment_services"
        tools:layout="@layout/fragment_services" />
    <fragment
        android:id="@+id/profilFragment"
        android:name="com.matrix.android105_android.presentation.ui.Profil.ProfilFragment"
        android:label="fragment_profil"
        tools:layout="@layout/fragment_profil" >

    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.matrix.android105_android.presentation.ui.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >

        <action
            android:id="@+id/action_splashFragment_to_logInFragment"
            app:destination="@id/logInFragment"
            app:popUpToInclusive="true"
            app:popUpTo="@id/splashFragment"/>
    </fragment>
    <fragment
        android:id="@+id/logInFragment"
        android:name="com.matrix.android105_android.presentation.ui.Login.LogInFragment"
        android:label="fragment_log_in"
        tools:layout="@layout/fragment_log_in" >
        <action
            android:id="@+id/action_logInFragment_to_verificationCodeFragment"
            app:destination="@id/verificationCodeFragment"
            />
        <action
            android:id="@+id/action_logInFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/verificationCodeFragment"
        android:name="com.matrix.android105_android.presentation.ui.verificationCode.VerificationCodeFragment"
        android:label="fragment_verification_code"
        tools:layout="@layout/fragment_verification_code" >
        <argument
            android:name="verificationId"
            app:argType="string" />
        <action
            android:id="@+id/action_verificationCodeFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.matrix.android105_android.presentation.ui.main.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_likedProductFragment"
            app:destination="@id/likedProductFragment" />
        <action
            android:id="@+id/action_mainFragment_to_basketProductFragment"
            app:destination="@id/basketProductFragment" />
        <action
            android:id="@+id/action_mainFragment_to_profilFragment"
            app:destination="@id/profilFragment" />
        <action
            android:id="@+id/action_mainFragment_to_profilDetailedFragment"
            app:destination="@id/profilDetailedFragment" />
        <action
            android:id="@+id/action_mainFragment_to_moreProductFragment"
            app:destination="@id/moreProductFragment" />
        <action
            android:id="@+id/action_mainFragment_to_logInFragment"
            app:destination="@id/logInFragment" />

    </fragment>
    <fragment
        android:id="@+id/likedProductFragment"
        android:name="com.matrix.android105_android.presentation.ui.LikedProduct.LikedProductFragment"
        android:label="fragment_liked_product"
        tools:layout="@layout/fragment_liked_product" />
    <fragment
        android:id="@+id/umicoMarketFragment"
        android:name="com.matrix.android105_android.presentation.ui.LikedProduct.UmicoMarketFragment"
        android:label="fragment_umico_market"
        tools:layout="@layout/fragment_umico_market" />

    <fragment
        android:id="@+id/basketProductFragment"
        android:name="com.matrix.android105_android.presentation.ui.BasketProduct.BasketProductFragment"
        android:label="fragment_basket_product"
        tools:layout="@layout/fragment_basket_product" >
        <action
            android:id="@+id/action_basketProductFragment_to_moreProductFragment"
            app:destination="@id/moreProductFragment" />
        <action
            android:id="@+id/action_basketProductFragment_to_catalogFragment"
            app:destination="@id/catalogFragment" />
    </fragment>
    <fragment
        android:id="@+id/umicoBonusFragment"
        android:name="com.matrix.android105_android.presentation.ui.LikedProduct.UmicoBonusFragment"
        android:label="fragment_umico_bonus"
        tools:layout="@layout/fragment_umico_bonus" />
    <fragment
        android:id="@+id/profilDetailedFragment"
        android:name="com.matrix.android105_android.presentation.ui.ProfilDetailed.ProfilDetailedFragment"
        android:label="fragment_profil_detailed"
        tools:layout="@layout/fragment_profil_detailed" >
        <action
            android:id="@+id/action_profilDetailedFragment_to_personalInformationFragment"
            app:destination="@id/personalInformationFragment" />
    </fragment>
    <fragment
        android:id="@+id/personalInformationFragment"
        android:name="com.matrix.android105_android.presentation.ui.ProfilDetailed.PersonalInformationFragment"
        android:label="fragment_personal_information"
        tools:layout="@layout/fragment_personal_information" />
    <fragment
        android:id="@+id/moreProductFragment"
        android:name="com.matrix.android105_android.presentation.ui.MoreProduct.MoreProductFragment"
        android:label="fragment_more_product"
        tools:layout="@layout/fragment_more_product" >
        <action
            android:id="@+id/action_moreProductFragment_to_basketProductFragment"
            app:destination="@id/basketProductFragment" />
        <action
            android:id="@+id/action_moreProductFragment_to_likedProductFragment"
            app:destination="@id/likedProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.matrix.android105_android.presentation.ui.Catalog.CatalogFragment"
        android:label="fragment_catalog"
        tools:layout="@layout/fragment_catalog" >
        <action
            android:id="@+id/action_catalogFragment_to_likedProductFragment"
            app:destination="@id/likedProductFragment" />
        <action
            android:id="@+id/action_catalogFragment_to_basketProductFragment"
            app:destination="@id/basketProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.matrix.android105_android.presentation.ui.ProductDetail.ProductDetailFragment"
        android:label="fragment_product_detail"
        tools:layout="@layout/fragment_product_detail" />
</navigation>